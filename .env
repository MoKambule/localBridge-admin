# Copy to .env and edit. Never commit .env.

# Database (defaults match the main app's compose.yml)
POSTGRES_USER=localbridge
POSTGRES_PASSWORD=localbridge101
POSTGRES_DB=localbridge
DB_PORT=5433

# API. Generate a secret with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters
COOKIE_SECURE=false

# First admin account, created on API start if the email does not exist yet.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@localbridge.local
ADMIN_PASSWORD=change-me-please

# For `npm run dev` in server/ (db published on the host port above):
DATABASE_URL=postgres://localbridge:localbridge101@localhost:5433/localbridge

WEB_PORT=8080
